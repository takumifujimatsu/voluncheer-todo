rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId
        || request.auth.token.email in ["fujimatsu.t@voluncheer.or.jp", "shimura@voluncheer.or.jp"];
      match /resourceFavorites/{resourceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /resourceLibraryOrder/{folderKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    // 資料室: フォルダ
    match /resourceFolders/{folderId} {
      allow read, write: if request.auth != null;
    }
    // 資料室: 資料
    match /resources/{resourceId} {
      allow read, write: if request.auth != null;
    }
    // メンバーダッシュボード: 1on1フィードバック（管理者のみ更新可）
    match /memberOneOnOneFeedback/{memberUid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email == "fujimatsu.t@voluncheer.or.jp";
    }
    // メンバーダッシュボード: 週次1on1フィードバック履歴
    match /memberOneOnOneFeedbackHistory/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email == "fujimatsu.t@voluncheer.or.jp";
    }
    // メンバーダッシュボード: コンディションステータス（各自のみ更新可）
    match /memberConditions/{memberUid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == memberUid;
      allow delete: if request.auth != null && request.auth.uid == memberUid;
    }
    // メンバーダッシュボード: ありがとうメッセージ（誰でも投稿可、閲覧可）
    match /peerBonuses/{bonusId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
